<h1 {{ block.shopify_attributes }}>{{ block.settings.heading | escape }}</h1>

{% schema %}
{
  "name": "Custom heading",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Hello in PERN Stack"
    }
  ]
}
{% endschema %}
